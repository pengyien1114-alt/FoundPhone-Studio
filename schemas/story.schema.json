{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scriptVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "phone": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string"
        },
        "date": {
          "default": "2026-10-23",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "passcode": {
          "type": "string",
          "maxLength": 12
        },
        "wallpaper": {
          "type": "string"
        },
        "lockWallpaper": {
          "type": "string",
          "pattern": "^data:image\\/(png|jpeg|webp);base64,[a-zA-Z0-9+/=]+$"
        },
        "homeWallpaper": {
          "type": "string",
          "pattern": "^data:image\\/(png|jpeg|webp);base64,[a-zA-Z0-9+/=]+$"
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "time": {
          "type": "string"
        },
        "battery": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "network": {
          "type": "string"
        },
        "notifications": {
          "type": "boolean"
        }
      },
      "required": [
        "owner",
        "date"
      ],
      "additionalProperties": false
    },
    "installedApps": {
      "default": [
        "appstore",
        "phone",
        "messages",
        "photos",
        "notes",
        "safari",
        "settings"
      ],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "installed": {
                "default": true,
                "type": "boolean"
              },
              "visible": {
                "type": "boolean"
              },
              "dock": {
                "type": "boolean"
              },
              "folder": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "installed",
              "visible",
              "dock",
              "folder",
              "icon"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "contacts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "default": "",
            "type": "string"
          },
          "avatar": {
            "default": "",
            "type": "string"
          },
          "bio": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "phone",
          "avatar",
          "bio"
        ],
        "additionalProperties": false
      }
    },
    "chats": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
          },
          "app": {
            "default": "messages",
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
                },
                "title": {
                  "default": "",
                  "type": "string"
                },
                "body": {
                  "default": "",
                  "type": "string"
                },
                "richText": {
                  "default": "",
                  "type": "string",
                  "maxLength": 400000
                },
                "meta": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "time": {
                  "type": "string"
                },
                "sender": {
                  "type": "string"
                },
                "avatar": {
                  "default": "",
                  "type": "string"
                },
                "kind": {
                  "default": "text",
                  "type": "string",
                  "enum": [
                    "text",
                    "image",
                    "audio",
                    "video",
                    "file",
                    "transfer",
                    "call",
                    "order",
                    "note",
                    "post",
                    "event"
                  ]
                },
                "media": {
                  "default": "",
                  "type": "string"
                },
                "hidden": {
                  "default": false,
                  "type": "boolean"
                },
                "unlock": {
                  "default": "",
                  "type": "string"
                },
                "password": {
                  "default": "",
                  "type": "string"
                },
                "folder": {
                  "default": "",
                  "type": "string"
                },
                "favorite": {
                  "default": false,
                  "type": "boolean"
                },
                "outgoing": {
                  "default": false,
                  "type": "boolean"
                },
                "read": {
                  "default": false,
                  "type": "boolean"
                },
                "likes": {
                  "default": 0,
                  "type": "number"
                },
                "comments": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "senderId": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "body"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "app",
          "title",
          "participants",
          "messages"
        ],
        "additionalProperties": false
      }
    },
    "content": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
            },
            "title": {
              "default": "",
              "type": "string"
            },
            "body": {
              "default": "",
              "type": "string"
            },
            "richText": {
              "default": "",
              "type": "string",
              "maxLength": 400000
            },
            "meta": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string",
                "maxLength": 60
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "time": {
              "type": "string"
            },
            "sender": {
              "type": "string"
            },
            "avatar": {
              "default": "",
              "type": "string"
            },
            "kind": {
              "default": "text",
              "type": "string",
              "enum": [
                "text",
                "image",
                "audio",
                "video",
                "file",
                "transfer",
                "call",
                "order",
                "note",
                "post",
                "event"
              ]
            },
            "media": {
              "default": "",
              "type": "string"
            },
            "hidden": {
              "default": false,
              "type": "boolean"
            },
            "unlock": {
              "default": "",
              "type": "string"
            },
            "password": {
              "default": "",
              "type": "string"
            },
            "folder": {
              "default": "",
              "type": "string"
            },
            "favorite": {
              "default": false,
              "type": "boolean"
            },
            "outgoing": {
              "default": false,
              "type": "boolean"
            },
            "read": {
              "default": false,
              "type": "boolean"
            },
            "likes": {
              "default": 0,
              "type": "number"
            },
            "comments": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "title",
            "body"
          ],
          "additionalProperties": false
        }
      }
    },
    "variables": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "events": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "delayMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "default": "event",
            "type": "string",
            "enum": [
              "start",
              "event",
              "condition",
              "action",
              "choice",
              "delay",
              "ending",
              "comment"
            ]
          },
          "event": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "neq",
                    "gt",
                    "lt",
                    "includes"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "required": [
                "key",
                "op",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "logic": {
            "default": "and",
            "type": "string",
            "enum": [
              "and",
              "or",
              "not"
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "date",
                    "variable",
                    "unlock",
                    "hide",
                    "notification",
                    "message",
                    "time",
                    "ending",
                    "choice",
                    "clue",
                    "call"
                  ]
                },
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "required": [
                "type",
                "key",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "next": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "once": {
            "type": "boolean"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "label",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "tests": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event": {
                  "type": "string"
                },
                "target": {
                  "default": "",
                  "type": "string"
                },
                "advanceMs": {
                  "type": "number",
                  "minimum": 0
                },
                "choose": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "target"
              ],
              "additionalProperties": false
            }
          },
          "ending": {
            "type": "string"
          },
          "expectUnlocked": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "steps",
          "ending",
          "expectUnlocked"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "scriptVersion",
    "id",
    "title",
    "description",
    "revision",
    "phone",
    "installedApps",
    "contacts",
    "chats",
    "content",
    "variables",
    "events",
    "tests"
  ],
  "additionalProperties": false
}
